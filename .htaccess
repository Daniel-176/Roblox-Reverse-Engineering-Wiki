RewriteEngine On

# Block direct access to includes/ and templates/
RewriteRule ^includes/ - [F,L]
RewriteRule ^templates/ - [F,L]

# Vault files are served as-is
RewriteRule ^vault/ - [L]

# Block access to .md files directly
RewriteRule \.md$ - [F,L]

# Deny access to hidden files
RewriteRule (^|/)\. - [F,L]
